{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "server/public",
  "rewrites": [
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/p/:project", "destination": "/api/page?project=:project" }
  ],
  "functions": {
    "api/*.js": { "maxDuration": 30, "includeFiles": "skills/artiboard/assets/board.html" }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/shim.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/changelog.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
