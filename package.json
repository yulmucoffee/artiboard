{
  "name": "artiboard",
  "version": "1.9.2",
  "description": "A shared task board for people and their coding agents: a claude.ai artifact, or self-hosted on SQLite or Supabase with an MCP server for Claude Code and Codex.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "artiboard": "server/cli.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server/cli.js serve",
    "test": "node --test \"tests/*.test.js\"",
    "deploy:vercel": "sh scripts/deploy-vercel.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@supabase/supabase-js": "2.117.2",
    "zod": "4.6.5"
  },
  "repository": "github:yulmucoffee/artiboard"
}
